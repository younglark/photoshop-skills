// export_slices.psjs
// Agent slicing export for Photoshop 23.5+.
// Reads a confirmed manifest JSON, exports 1x PNGs by layer_id (effects baked in),
// records visible / logical bounds and text attributes, and writes a full artboard render.
// Hidden state layers are temporarily shown for their slice, then restored; the doc is never saved.
//
// Point CONFIG_URL at the job config JSON (must already exist). Do not pass CLI arguments
// (the script will not run). See export_config.example.json.
// Use dialogOptions "silent" on every descriptor; "dontDisplay" still pops error dialogs.
// Top-level await is required. Only documents in the target set are edited or closed.

const { app, core, action } = require("photoshop");
const fs = require("uxp").storage.localFileSystem;

// --- the only path the script itself hardcodes; edit this for the job ---
const CONFIG_URL = "file:/D:/work/ps-job/export_config.json";
// -----------------------------------------------------------------------

let ROOT_URL, SOURCE_URL, SOURCE_PATH_HINT, MANIFEST_NAME, LOG_NAME, SLICES_DIR_NAME, FULL_RENDER_NAME;

async function loadConfig() {
  const entry = await fs.getEntryWithUrl(CONFIG_URL);
  const cfg = JSON.parse(await entry.read());
  if (!cfg || !cfg.root_url || !cfg.source_url) {
    throw new Error("export config must include root_url and source_url");
  }
  ROOT_URL = cfg.root_url;
  SOURCE_URL = cfg.source_url;
  SOURCE_PATH_HINT = cfg.source_path_hint || "";
  MANIFEST_NAME = cfg.manifest_name || "manifest.json";
  LOG_NAME = cfg.log_name || "export_log.json";
  SLICES_DIR_NAME = cfg.slices_dir_name || "slices";
  FULL_RENDER_NAME = cfg.full_render_name || "full_render.png";
}


const log = {
  started: new Date().toISOString(),
  done: false,
  ok: false,
  fatal: null,
  errs: [],
  docs_before: [],
  docs_after: [],
  src: null,
  items: [],
  bound_keys_sample: null,
  full_render: null
};

const ours = new Set();
let rootDir;
let slicesDir;
let weOpenedSource = false;

function nowMs() { return Date.now(); }

function val(x) {
  if (x == null) return null;
  if (typeof x === "object" && "_value" in x) return x._value;
  return x;
}

function unitRect(r) {
  if (!r || typeof r !== "object") return null;
  const left = (r.left != null) ? val(r.left) : ((r._left != null) ? r._left : null);
  const top = (r.top != null) ? val(r.top) : ((r._top != null) ? r._top : null);
  const right = (r.right != null) ? val(r.right) : ((r._right != null) ? r._right : null);
  const bottom = (r.bottom != null) ? val(r.bottom) : ((r._bottom != null) ? r._bottom : null);
  if (left == null || top == null || right == null || bottom == null) return null;
  return { left: left, top: top, right: right, bottom: bottom };
}

function packDomBounds(b) {
  return unitRect(b);
}

function collectBoundKeys(desc) {
  const out = {};
  if (!desc) return out;
  for (const key of Object.keys(desc)) {
    if (/bound|rect/i.test(key)) out[key] = desc[key];
  }
  return out;
}

function rgbHex(c) {
  if (!c) return null;
  const r = Math.round(val(c.red) != null ? val(c.red) : 0);
  const g = Math.round(val(c.grain) != null ? val(c.grain) : (val(c.green) != null ? val(c.green) : 0));
  const b = Math.round(val(c.blue) != null ? val(c.blue) : 0);
  const h = (n) => Math.max(0, Math.min(255, n)).toString(16).padStart(2, "0");
  return "#" + h(r) + h(g) + h(b);
}

// Photoshop layerEffects keys -> engine_effects type names (see text_render.py).
const PS_EFFECT_TYPES = {
  frameFX: "Stroke", dropShadow: "DropShadow", outerGlow: "OuterGlow", innerShadow: "InnerShadow",
  innerGlow: "InnerGlow", solidFill: "ColorOverlay", gradientFill: "GradientOverlay",
  patternFill: "PatternOverlay", chromeFX: "Satin", bevelEmboss: "BevelEmboss"
};
const STROKE_POSITIONS = { outsetFrame: "outside", insetFrame: "inside", centeredFrame: "center" };

function enumVal(x) {
  if (x && typeof x === "object" && "_value" in x) return x._value;
  return (x == null) ? null : x;
}

function unitOpacity(v) {
  const n = val(v);
  if (n == null) return null;
  return Math.max(0, Math.min(1, n > 1 ? n / 100 : n));
}

// Every present effect with its own enabled flag; effects_visible is the layer's master switch.
function effectsFromDesc(desc) {
  const fx = (desc && desc.layerEffects) || {};
  const visible = (desc && desc.layerFXVisible != null) ? !!desc.layerFXVisible : true;
  const globalAngle = (desc && desc.globalAngle != null) ? val(desc.globalAngle) : 90;
  const out = [];
  for (const key of Object.keys(fx)) {
    const base = key.endsWith("Multi") ? key.slice(0, -5) : key;
    if (!PS_EFFECT_TYPES[base]) continue;
    const list = Array.isArray(fx[key]) ? fx[key] : [fx[key]];
    for (const e of list) {
      if (!e || typeof e !== "object" || e.present === false) continue;
      const item = { type: PS_EFFECT_TYPES[base], enabled: e.enabled !== false };
      if (e.mode) item.blend_mode = String(enumVal(e.mode)).toLowerCase();
      if (e.color) item.color = rgbHex(e.color);
      if (e.opacity != null) item.opacity = unitOpacity(e.opacity);
      if (base === "frameFX") {
        item.size = val(e.size);
        const st = enumVal(e.style) || "outsetFrame";
        item.position = STROKE_POSITIONS[st] || st;
        item.fill_type = enumVal(e.paintType) || "solidColor";
      } else if (base === "dropShadow" || base === "innerShadow") {
        item.size = val(e.blur);
        item.distance = val(e.distance);
        item[base === "dropShadow" ? "spread" : "choke"] = val(e.chokeMatte);
        item.use_global_light = !!e.useGlobalAngle;
        item.angle = e.useGlobalAngle ? globalAngle : val(e.localLightingAngle);
      } else if (base === "outerGlow" || base === "innerGlow") {
        item.size = val(e.blur);
        item[base === "outerGlow" ? "spread" : "choke"] = val(e.chokeMatte);
        if (e.inputRange != null) item.range = val(e.inputRange);
      }
      out.push(item);
    }
  }
  return { visible: visible, effects: out };
}

// Legacy single stroke field: only when the layer's effects are visible and the stroke is enabled.
function strokeFromEffects(fxInfo) {
  if (!fxInfo.visible) return null;
  for (const e of fxInfo.effects) {
    if (e.type !== "Stroke" || !e.enabled) continue;
    return { enabled: true, position: e.position, size: e.size, color: e.color || null,
             opacity: e.opacity, mode: e.blend_mode || null };
  }
  return null;
}

function isAttrText(kind) {
  return kind === "dynamic_text" || kind === "static_text";
}

// dynamic_text / static_text attributes, text_attrs_version 2 (references/slicing.md). Mirrors
// text_attrs_from_descriptor() in text_render.py. size / size_px are device pixels
// (transform applied); size_pt / leading_pt are Photoshop text-space points.
function parseText(desc) {
  const tk = desc && desc.textKey;
  if (!tk) return null;
  const content = (typeof tk.textKey === "string") ? tk.textKey : (tk.text || "");
  const tf = tk.transform || {};
  const m = { xx: tf.xx != null ? tf.xx : 1, xy: tf.xy || 0, yx: tf.yx || 0, yy: tf.yy != null ? tf.yy : 1 };
  const sx = Math.hypot(m.xx, m.xy) || 1;
  const sy = Math.hypot(m.yx, m.yy) || 1;
  const runs = (tk.textStyleRange || []).map((r) => {
    const st = r.textStyle || {};
    const sizePt = val(st.size);
    const implied = val(st.impliedFontSize);
    const leadPt = val(st.leading);
    const impliedLead = val(st.impliedLeading);
    const autoLead = (st.autoLeading == null) ? true : !!st.autoLeading;
    return {
      from: r.from || 0,
      to: r.to || 0,
      font: st.fontPostScriptName || st.fontName || null,
      size_pt: sizePt,
      size_px: (implied != null) ? implied : (sizePt != null ? sizePt * sy : null),
      color: st.color ? rgbHex(st.color) : "#000000",
      tracking: st.tracking != null ? val(st.tracking) : 0,
      auto_leading: autoLead,
      leading_pt: autoLead ? null : leadPt,
      leading_px: autoLead ? null : ((impliedLead != null) ? impliedLead : (leadPt != null ? leadPt * sy : null)),
      baseline_shift_pt: val(st.baselineShift) || 0,
      faux_bold: !!st.syntheticBold,
      faux_italic: !!st.syntheticItalic,
      horizontal_scale: st.horizontalScale != null ? st.horizontalScale : 100,
      vertical_scale: st.verticalScale != null ? st.verticalScale : 100,
      auto_kern: enumVal(st.autoKern) || "manual"
    };
  });
  const paragraphs = (tk.paragraphStyleRange || []).map((p) => {
    const ps = p.paragraphStyle || {};
    return {
      from: p.from || 0, to: p.to || 0,
      align: enumVal(ps.align) || "left",
      auto_leading_pct: ps.autoLeadingPercentage != null ? val(ps.autoLeadingPercentage) : null,
      leading_type: enumVal(ps.leadingType) || null
    };
  });
  const kerns = Array.from(new Set(runs.map((r) => String(r.auto_kern)))).sort();
  const shapes = tk.textShape || [];
  let shape = "point";
  let boxPt = null;
  if (shapes.length && enumVal(shapes[0].char) === "box") {
    shape = "box";
    const b = shapes[0].bounds;
    if (b) boxPt = { left: val(b.left), top: val(b.top), right: val(b.right), bottom: val(b.bottom) };
  }
  const fxInfo = effectsFromDesc(desc);
  const first = runs[0] || {};
  const click = tk.textClickPoint;
  const warp = tk.warp ? enumVal(tk.warp.warpStyle) : null;
  return {
    text_attrs_version: 2,
    content: content,
    font: first.font || null,
    size: (first.size_px != null) ? first.size_px : null,
    size_pt: (first.size_pt != null) ? first.size_pt : null,
    color: first.color || null,
    alignment: paragraphs.length ? paragraphs[0].align : null,
    leading_type: paragraphs.length ? paragraphs[0].leading_type : null,
    tracking: (first.tracking != null) ? first.tracking : null,
    leading: (first.leading_pt != null) ? first.leading_pt : null,
    leading_px: (first.leading_px != null) ? first.leading_px : null,
    auto_leading: (first.auto_leading != null) ? first.auto_leading : null,
    stroke: strokeFromEffects(fxInfo),
    opacity: (desc.opacity != null) ? (val(desc.opacity) / 255) : null,
    fill_opacity: (desc.fillOpacity != null) ? (val(desc.fillOpacity) / 255) : null,
    click_point: click ? { horizontal: val(click.horizontal), vertical: val(click.vertical) } : null,
    transform: { xx: m.xx, xy: m.xy, yx: m.yx, yy: m.yy, tx: tf.tx || 0, ty: tf.ty || 0 },
    scale: { x: sx, y: sy },
    runs: runs,
    paragraphs: paragraphs,
    kerning: kerns.length === 1 ? kerns[0] : (kerns.length ? "mixed" : "manual"),
    manual_kerning_ranges: (tk.kerningRange || []).length,
    anti_alias: tk.antiAlias ? enumVal(tk.antiAlias) : null,
    warp: (warp && warp !== "warpNone") ? warp : null,
    shape: shape,
    box_bounds_pt: boxPt,
    effects_visible: fxInfo.visible,
    layer_effects: fxInfo.effects
  };
}

function pickBounds(desc, domLayer) {
  const keys = collectBoundKeys(desc);
  const logical = unitRect(desc && desc.boundsNoEffects)
    || (domLayer && domLayer.boundsNoEffects && unitRect(domLayer.boundsNoEffects))
    || null;
  // Prefer an explicit with-effects rect when present.
  const visible = unitRect(desc && (desc.boundsWithEffects || desc.boundsWithFX || desc.boundsExtended))
    || (domLayer && domLayer.bounds && unitRect(domLayer.bounds))
    || unitRect(desc && desc.bounds)
    || null;
  return { keys: keys, logical: logical, visible: visible };
}

function samePath(a, b) {
  const norm = (s) => String(s || "").replace(/\//g, "\\").replace(/^file:\\?/i, "").toLowerCase();
  return norm(a) === norm(b);
}

function snapshotDocs() {
  return app.documents.map((d) => ({
    name: d.name,
    id: d.id,
    path: d.path || "",
    saved: d.saved
  }));
}

function findLayer(container, id) {
  const layers = container.layers || [];
  for (const layer of layers) {
    if (layer.id === id) return layer;
    if (layer.layers && layer.layers.length) {
      const found = findLayer(layer, id);
      if (found) return found;
    }
  }
  return null;
}

function collectAncestorChain(container, id, chain) {
  const layers = container.layers || [];
  for (const layer of layers) {
    if (layer.id === id) return true;
    if (layer.layers && layer.layers.length) {
      if (collectAncestorChain(layer, id, chain)) {
        chain.push(layer);
        return true;
      }
    }
  }
  return false;
}

// Temporarily show a hidden state layer and any hidden ancestors so rasterization
// has pixels. Always restore before the next slice / full render. The source is
// closed without saving when this script opened it.
function revealHiddenChain(src, ids) {
  const restored = [];
  const seen = new Set();
  for (const id of ids) {
    if (id == null) continue;
    const layer = findLayer(src, id);
    const chain = [];
    collectAncestorChain(src, id, chain);
    const all = [];
    if (layer) all.push(layer);
    for (const ancestor of chain) all.push(ancestor);
    for (const lyr of all) {
      if (!lyr || seen.has(lyr.id)) continue;
      seen.add(lyr.id);
      try {
        if (lyr.visible === false) {
          restored.push({ id: lyr.id, name: lyr.name || "", wasVisible: false });
          lyr.visible = true;
        }
      } catch (err) {
        restored.push({ id: lyr.id, name: (lyr && lyr.name) || "", error: String(err) });
      }
    }
  }
  return restored;
}

function restoreHiddenChain(src, restored) {
  if (!restored || !restored.length) return;
  for (let i = restored.length - 1; i >= 0; i--) {
    const rec = restored[i];
    if (rec.wasVisible !== false) continue;
    const lyr = findLayer(src, rec.id);
    if (!lyr) continue;
    try { lyr.visible = false; } catch (err) {}
  }
}

async function flush() {
  const file = await rootDir.createFile(LOG_NAME, { overwrite: true });
  await file.write(JSON.stringify(log, null, 2));
}

async function bp(descriptors) {
  const active = app.activeDocument;
  if (!active || !ours.has(active.id)) {
    throw new Error("GUARD: active document is not ours: " + (active && (active.name + " id=" + active.id)));
  }
  const descs = descriptors.map((d) => {
    const copy = Object.assign({}, d);
    copy._options = Object.assign({}, d._options || {}, { dialogOptions: "silent" });
    return copy;
  });
  const result = await action.batchPlay(descs, {});
  for (const item of result) {
    if (item && item._obj === "error") {
      throw new Error(JSON.stringify(item).slice(0, 400));
    }
  }
  return result;
}

async function ensureEightBit(doc) {
  try {
    if (doc.bitsPerChannel && doc.bitsPerChannel !== "bitDepth8") {
      await bp([{ _obj: "convertMode", depth: 8, merge: false }]);
    }
  } catch (err) {
    log.errs.push({ convertMode: String(err) });
  }
}

async function closeTemp(doc) {
  if (!doc) return;
  try {
    if (ours.has(doc.id)) {
      await doc.closeWithoutSaving();
      ours.delete(doc.id);
    }
  } catch (err) {
    log.errs.push({ close_temp: String(err) });
  }
}

// Avatar/frame split inside the temporary export document (never in the source document):
// Edit Contents opens the embedded smart object of the temporary copy, the listed inner layers
// are hidden, the contents are saved back into that copy only, and the copy is exported as usual.
// Checked on Photoshop 2026 (references/slicing.md): the source document stays unchanged.
function walkLayers(container, out) {
  for (const layer of container.layers || []) {
    out.push(layer);
    if (layer.layers && layer.layers.length) walkLayers(layer, out);
  }
  return out;
}

function matchInnerLayer(all, spec) {
  if (spec == null) return null;
  const id = (typeof spec === "object") ? spec.id : (typeof spec === "number" ? spec : null);
  const name = (typeof spec === "object") ? spec.name : (typeof spec === "string" ? spec : null);
  if (id != null) {
    const byId = all.find((layer) => layer.id === id);
    if (byId && (name == null || byId.name === name)) return byId;
  }
  if (name != null) {
    const byName = all.filter((layer) => layer.name === name);
    if (byName.length === 1) return byName[0];
  }
  return null;
}

async function applySmartObjectSplit(tmp, split, item) {
  const hide = (split && split.hide_inner) || [];
  if (!hide.length) throw new Error("split.hide_inner is empty");
  const smart = walkLayers(tmp, []).filter((layer) => String(layer.kind).toLowerCase().indexOf("smart") >= 0);
  if (smart.length !== 1) {
    throw new Error("split: expected one smart object in the temporary document, found " + smart.length);
  }
  await bp([{ _obj: "select", _target: [{ _ref: "layer", _id: smart[0].id }], makeVisible: false }]);
  const before = new Set(app.documents.map((d) => d.id));
  await bp([{ _obj: "placedLayerEditContents" }]);
  const added = app.documents.filter((d) => !before.has(d.id));
  if (added.length !== 1) throw new Error("split: Edit Contents opened " + added.length + " documents");
  const inner = added[0];
  ours.add(inner.id);
  const record = { contents: inner.name, hidden: [], not_found: [] };
  try {
    app.activeDocument = inner;
    const all = walkLayers(inner, []);
    for (const spec of hide) {
      const layer = matchInnerLayer(all, spec);
      if (!layer) { record.not_found.push(spec); continue; }
      layer.visible = false;
      record.hidden.push({ id: layer.id, name: layer.name });
    }
    if (record.not_found.length) {
      throw new Error("split: inner layers not found: " + JSON.stringify(record.not_found));
    }
    await inner.save();
  } finally {
    await closeTemp(inner);
    app.activeDocument = tmp;
    item.split_applied = record;
  }
}

try {
  await loadConfig();
  rootDir = await fs.getEntryWithUrl(ROOT_URL);
  try {
    slicesDir = await rootDir.getEntry(SLICES_DIR_NAME);
  } catch (err) {
    slicesDir = await rootDir.createFolder(SLICES_DIR_NAME);
  }
  log.docs_before = snapshotDocs();
  await flush();

  const manifestFile = await rootDir.getEntry(MANIFEST_NAME);
  const manifestText = await manifestFile.read();
  // 1.4.9 manifest lock: `slicing_helper.py confirm` writes <stem>.confirmed.json (byte copy).
  // A different manifest text means it was edited after the user confirmed it: refuse to export.
  const lockName = MANIFEST_NAME.replace(/\.json$/i, "") + ".confirmed.json";
  let lockedText = null;
  try {
    const lockFile = await rootDir.getEntry(lockName);
    lockedText = await lockFile.read();
  } catch (errLock) {
    lockedText = null;
  }
  log.manifest_locked = lockedText !== null;
  if (lockedText !== null && lockedText !== manifestText) {
    throw new Error("manifest_changed_after_confirm: " + MANIFEST_NAME + " differs from " + lockName +
      "; restore the confirmed manifest, write manifest.proposal.json and ask the user to re-confirm");
  }
  const manifest = JSON.parse(manifestText);
  if (manifest.status && manifest.status !== "confirmed" && manifest.status !== "pending_review") {
    // pending_review is allowed only when the operator explicitly treats the auto manifest as confirmed.
    throw new Error("manifest.status must be confirmed (or pending_review for an authorized test run)");
  }
  const artboard = manifest.source && manifest.source.artboard;
  const entries = manifest.entries || [];

  await core.executeAsModal(async (executionContext) => {
    let src = null;
    try {
      executionContext.reportProgress({ value: 0.02, commandName: "open source" });
      // Reuse the copy if it is already open (match by path). Never fall back to another file of the same name.
      for (const doc of app.documents) {
        if (SOURCE_PATH_HINT && doc.path && samePath(doc.path, SOURCE_PATH_HINT)) {
          src = doc;
          break;
        }
      }
      if (!src) {
        const entry = await fs.getEntryWithUrl(SOURCE_URL);
        src = await app.open(entry);
        weOpenedSource = true;
      }
      ours.add(src.id);
      app.activeDocument = src;
      if (weOpenedSource) {
        await executionContext.hostControl.registerAutoCloseDocument(src.id);
      }
      log.src = { name: src.name, id: src.id, path: src.path || "", w: src.width, h: src.height };
      if (SOURCE_PATH_HINT && src.path && !samePath(src.path, SOURCE_PATH_HINT)) {
        throw new Error("GUARD: opened unexpected path: " + src.path);
      }
      await flush();

      let suspension;
      try {
        suspension = await executionContext.hostControl.suspendHistory({
          documentID: src.id,
          name: "agent slice export"
        });
      } catch (err) {
        log.errs.push({ suspendHistory: String(err) });
      }

      const total = entries.length + 1;
      for (let i = 0; i < entries.length; i++) {
        const entry = entries[i];
        const item = {
          name: entry.name,
          layer_id: entry.layer_id,
          kind: entry.kind,
          ok: false
        };
        const t1 = nowMs();
        let revealed = [];
        try {
          app.activeDocument = src;
          if (!ours.has(src.id)) throw new Error("GUARD: lost source doc");
          const selectIds = (entry.select_ids && entry.select_ids.length)
            ? entry.select_ids
            : [entry.layer_id];
          if (entry.hidden || entry.from_hidden) {
            revealed = revealHiddenChain(src, selectIds);
            item.revealed = revealed.map((r) => r.id);
          }
          const info = await bp([{ _obj: "get", _target: [{ _ref: "layer", _id: entry.layer_id }] }]);
          const desc = info[0] || {};
          if (!log.bound_keys_sample) {
            log.bound_keys_sample = {
              layer_id: entry.layer_id,
              keys: collectBoundKeys(desc)
            };
          }
          const domLayer = findLayer(src, entry.layer_id);
          const bounds = pickBounds(desc, domLayer);
          item.ps_name = desc.name;
          item.visible_flag = desc.visible;
          item.bound_keys = Object.keys(bounds.keys);
          item.logical_bounds = bounds.logical;
          item.visible_bounds = bounds.visible;
          item.boundsNoEffects = bounds.logical;
          if (isAttrText(entry.kind) || desc.textKey) {
            item.text = parseText(desc) || entry.text || null;
          }
          if (entry.reuse_of) item.reuse_of = entry.reuse_of;
          // Reused instance (export_png === false) or attribute-only text: record
          // bounds / text attrs only; build-layout places shared images, if any.
          if (isAttrText(entry.kind) || entry.export_png === false) {
            if (entry.export_png === false) item.bounds_only = true;
            item.ok = true;
            if (revealed && revealed.length) {
              // This path skips the shared restore below, so restore visibility here.
              try { restoreHiddenChain(src, revealed); } catch (errR) { item.restore_error = String(errR); }
            }
            item.ms = nowMs() - t1;
            log.items.push(item);
            await flush();
            continue;
          }

          // Select base + any visible clipped layers, then new document from the target.
          // effect_mode "engine": select_ids are the children of an effect group; the new
          // document has no parent group, so the group's effects are intentionally not baked.
          const selectDescs = selectIds.map((id, idx) => {
            const d = {
              _obj: "select",
              _target: [{ _ref: "layer", _id: id }],
              makeVisible: false
            };
            if (idx > 0) {
              d.selectionModifier = { _enum: "selectionModifierType", _value: "addToSelection" };
            }
            return d;
          });
          await bp(selectDescs);
          await bp([{
            _obj: "make",
            _target: [{ _ref: "document" }],
            name: entry.name,
