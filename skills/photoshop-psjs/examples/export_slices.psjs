// export_slices.psjs
// Agent slicing export for Photoshop 23.5+.
// Reads a confirmed manifest JSON, exports 1x PNGs by layer_id (effects baked in),
// records visible / logical bounds and text attributes, and writes a full artboard render.
// Hidden state layers are temporarily shown for their slice, then restored; the doc is never saved.
//
// Point CONFIG_URL at the job config JSON (must already exist). Do not pass CLI arguments
// (the script will not run). See export_config.example.json.
// Use dialogOptions "silent" on every descriptor; "dontDisplay" still pops error dialogs.
// Top-level await is required. Only documents in the target set are edited or closed.
//
// 1.4.12 records (validate checks them; see references/slicing.md):
// - exporter: sha256 of this script (config exporter_url points at the job copy; only CONFIG_URL may differ),
//   compared with the skill's shipped examples/export_slices.psjs (exporter_modified);
// - layers_at_open: every layer's visibility right after the document is opened, before any temporary change;
//   full_render.hidden_at_render: layers visible at open but hidden when the full render was taken
//   (visible_layer_hidden unless the user chose to exclude them);
// - only layers of a reuse_decisions entry the user answered "exclude" (recorded by `confirm --decision` in the
//   lock's decision_log) are hidden, for slices and the full render. There is no other hide switch.
// - multi-layer entries (select_ids): select_bounds per layer and logical_bounds_union.
// 1.4.13: layers_at_open_ms and full_render.hidden_at_render_ms record how long each layer snapshot took
// (observability only; the snapshot itself is unchanged). Copy this file byte for byte (shutil.copy2,
// Copy-Item, cmd /c copy), not with PowerShell 5 Get-Content / Set-Content, which rewrites non-ASCII text,
// nor with Python text mode on Windows (write_text / open("w") turn LF into CRLF).
// 1.4.15: a slice whose layer was hidden at open and is covered by an unanswered blocking decision is not rendered
// (item.skipped_pending_decision, log.skipped_pending_decision); every rendered PNG records exported_at, so
// validate can tell a PNG made before the user's answer (exported_before_decision).
// 1.4.16: a slice shows only what the document shows. When an ancestor group's layer / vector mask or the layer's
// clipping base (not selected with it) hides part of the layer, the temporary copy is cropped to that area before
// trim (item.mask_clip: clipped, cropped, clip_bounds, layer_bounds, sources; item.mask_clipped). The crop is the
// mask's bounding box; validate (slice_exceeds_visible_area) checks the pixels. A user's unmasked_asset answer
// (unmasked) keeps the whole layer.

const { app, core, action } = require("photoshop");
const fs = require("uxp").storage.localFileSystem;

// --- the only path the script itself hardcodes; edit this for the job ---
const CONFIG_URL = "file:/D:/work/ps-job/export_config.json";
// -----------------------------------------------------------------------

const EXPORTER_RELEASE = "1.4.16";
let ROOT_URL, SOURCE_URL, SOURCE_PATH_HINT, MANIFEST_NAME, LOG_NAME, SLICES_DIR_NAME, FULL_RENDER_NAME, EXPORTER_URL;

async function loadConfig() {
  const entry = await fs.getEntryWithUrl(CONFIG_URL);
  const cfg = JSON.parse(await entry.read());
  if (!cfg || !cfg.root_url || !cfg.source_url) {
    throw new Error("export config must include root_url and source_url");
  }
  ROOT_URL = cfg.root_url;
  SOURCE_URL = cfg.source_url;
  SOURCE_PATH_HINT = cfg.source_path_hint || "";
  MANIFEST_NAME = cfg.manifest_name || "manifest.json";
  LOG_NAME = cfg.log_name || "export_log.json";
  SLICES_DIR_NAME = cfg.slices_dir_name || "slices";
  FULL_RENDER_NAME = cfg.full_render_name || "full_render.png";
  EXPORTER_URL = cfg.exporter_url || "";
}

// <sha256>
// sha256 of the exporter text: CRLF -> LF, BOM dropped, the CONFIG_URL line blanked (slicing_helper.py
// exporter_text_sha256 computes the same). Plain JS: UXP has no crypto digest.
function normalizeExporterText(text) {
  let t = String(text || "");
  if (t.charCodeAt(0) === 0xfeff) t = t.slice(1);
  t = t.replace(/\r\n/g, "\n");
  return t.replace(/^const CONFIG_URL = .*$/m, 'const CONFIG_URL = "";');
}

function utf8Bytes(str) {
  const out = [];
  for (let i = 0; i < str.length; i++) {
    let c = str.charCodeAt(i);
    if (c >= 0xd800 && c <= 0xdbff && i + 1 < str.length) {
      const d = str.charCodeAt(i + 1);
      if (d >= 0xdc00 && d <= 0xdfff) { c = 0x10000 + ((c - 0xd800) << 10) + (d - 0xdc00); i++; }
    }
    if (c < 0x80) out.push(c);
    else if (c < 0x800) out.push(0xc0 | (c >> 6), 0x80 | (c & 63));
    else if (c < 0x10000) out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
    else out.push(0xf0 | (c >> 18), 0x80 | ((c >> 12) & 63), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
  }
  return out;
}

function sha256Hex(bytes) {
  const K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
  ];
  const H = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const msg = bytes.slice();
  const bitLen = bytes.length * 8;
  msg.push(0x80);
  while (msg.length % 64 !== 56) msg.push(0);
  const hi = Math.floor(bitLen / 0x100000000);
  const lo = bitLen >>> 0;
  msg.push((hi >>> 24) & 255, (hi >>> 16) & 255, (hi >>> 8) & 255, hi & 255,
           (lo >>> 24) & 255, (lo >>> 16) & 255, (lo >>> 8) & 255, lo & 255);
  const W = new Array(64);
  const rotr = (x, n) => (x >>> n) | (x << (32 - n));
  for (let off = 0; off < msg.length; off += 64) {
    for (let t = 0; t < 16; t++) {
      const j = off + t * 4;
      W[t] = ((msg[j] << 24) | (msg[j + 1] << 16) | (msg[j + 2] << 8) | msg[j + 3]) | 0;
    }
    for (let t = 16; t < 64; t++) {
      const s0 = rotr(W[t - 15], 7) ^ rotr(W[t - 15], 18) ^ (W[t - 15] >>> 3);
      const s1 = rotr(W[t - 2], 17) ^ rotr(W[t - 2], 19) ^ (W[t - 2] >>> 10);
      W[t] = (W[t - 16] + s0 + W[t - 7] + s1) | 0;
    }
    let a = H[0], b = H[1], c = H[2], d = H[3], e = H[4], f = H[5], g = H[6], h = H[7];
    for (let t = 0; t < 64; t++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const t1 = (h + S1 + ch + K[t] + W[t]) | 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const mj = (a & b) ^ (a & c) ^ (b & c);
      const t2 = (S0 + mj) | 0;
      h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
    }
    H[0] = (H[0] + a) | 0; H[1] = (H[1] + b) | 0; H[2] = (H[2] + c) | 0; H[3] = (H[3] + d) | 0;
    H[4] = (H[4] + e) | 0; H[5] = (H[5] + f) | 0; H[6] = (H[6] + g) | 0; H[7] = (H[7] + h) | 0;
  }
  return H.map((x) => (x >>> 0).toString(16).padStart(8, "0")).join("");
}

function exporterSha256(text) {
  return sha256Hex(utf8Bytes(normalizeExporterText(text)));
}
// </sha256>

async function exporterIdentity() {
  const rec = { release: EXPORTER_RELEASE, script_url: EXPORTER_URL || null, script_path: null, sha256: null };
  if (!EXPORTER_URL) {
    rec.error = "exporter_url not set in the export config (point it at this script file)";
    return rec;
  }
  try {
    const entry = await fs.getEntryWithUrl(EXPORTER_URL);
    rec.script_path = entry.nativePath || null;
    rec.sha256 = exporterSha256(await entry.read());
  } catch (err) {
    rec.error = "cannot read exporter_url: " + String((err && err.message) || err);
  }
  return rec;
}


const log = {
  started: new Date().toISOString(),
  done: false,
  ok: false,
  fatal: null,
  errs: [],
  docs_before: [],
  docs_after: [],
  src: null,
  items: [],
  bound_keys_sample: null,
  full_render: null,
  exporter: null,
  layers_at_open: null,
  layers_at_open_ms: null,
  layers_at_open_count: null,
  excluded_by_user_decision: [],
  pending_user_decisions: [],
  skipped_pending_decision: []
};

const ours = new Set();
let rootDir;
let slicesDir;
let weOpenedSource = false;

function nowMs() { return Date.now(); }

function val(x) {
  if (x == null) return null;
  if (typeof x === "object" && "_value" in x) return x._value;
  return x;
}

function unitRect(r) {
  if (!r || typeof r !== "object") return null;
  const left = (r.left != null) ? val(r.left) : ((r._left != null) ? r._left : null);
  const top = (r.top != null) ? val(r.top) : ((r._top != null) ? r._top : null);
  const right = (r.right != null) ? val(r.right) : ((r._right != null) ? r._right : null);
  const bottom = (r.bottom != null) ? val(r.bottom) : ((r._bottom != null) ? r._bottom : null);
  if (left == null || top == null || right == null || bottom == null) return null;
  return { left: left, top: top, right: right, bottom: bottom };
}

function packDomBounds(b) {
  return unitRect(b);
}

function collectBoundKeys(desc) {
  const out = {};
  if (!desc) return out;
  for (const key of Object.keys(desc)) {
    if (/bound|rect/i.test(key)) out[key] = desc[key];
  }
  return out;
}

function rgbHex(c) {
  if (!c) return null;
  const r = Math.round(val(c.red) != null ? val(c.red) : 0);
  const g = Math.round(val(c.grain) != null ? val(c.grain) : (val(c.green) != null ? val(c.green) : 0));
  const b = Math.round(val(c.blue) != null ? val(c.blue) : 0);
  const h = (n) => Math.max(0, Math.min(255, n)).toString(16).padStart(2, "0");
  return "#" + h(r) + h(g) + h(b);
}

// Photoshop layerEffects keys -> engine_effects type names (see text_render.py).
const PS_EFFECT_TYPES = {
  frameFX: "Stroke", dropShadow: "DropShadow", outerGlow: "OuterGlow", innerShadow: "InnerShadow",
  innerGlow: "InnerGlow", solidFill: "ColorOverlay", gradientFill: "GradientOverlay",
  patternFill: "PatternOverlay", chromeFX: "Satin", bevelEmboss: "BevelEmboss"
};
const STROKE_POSITIONS = { outsetFrame: "outside", insetFrame: "inside", centeredFrame: "center" };

function enumVal(x) {
  if (x && typeof x === "object" && "_value" in x) return x._value;
  return (x == null) ? null : x;
}

function unitOpacity(v) {
  const n = val(v);
  if (n == null) return null;
  return Math.max(0, Math.min(1, n > 1 ? n / 100 : n));
}

// Every present effect with its own enabled flag; effects_visible is the layer's master switch.
function effectsFromDesc(desc) {
  const fx = (desc && desc.layerEffects) || {};
  const visible = (desc && desc.layerFXVisible != null) ? !!desc.layerFXVisible : true;
  const globalAngle = (desc && desc.globalAngle != null) ? val(desc.globalAngle) : 90;
  const out = [];
  for (const key of Object.keys(fx)) {
    const base = key.endsWith("Multi") ? key.slice(0, -5) : key;
    if (!PS_EFFECT_TYPES[base]) continue;
    const list = Array.isArray(fx[key]) ? fx[key] : [fx[key]];
    for (const e of list) {
      if (!e || typeof e !== "object" || e.present === false) continue;
      const item = { type: PS_EFFECT_TYPES[base], enabled: e.enabled !== false };
      if (e.mode) item.blend_mode = String(enumVal(e.mode)).toLowerCase();
      if (e.color) item.color = rgbHex(e.color);
      if (e.opacity != null) item.opacity = unitOpacity(e.opacity);
      if (base === "frameFX") {
        item.size = val(e.size);
        const st = enumVal(e.style) || "outsetFrame";
        item.position = STROKE_POSITIONS[st] || st;
        item.fill_type = enumVal(e.paintType) || "solidColor";
      } else if (base === "dropShadow" || base === "innerShadow") {
        item.size = val(e.blur);
        item.distance = val(e.distance);
        item[base === "dropShadow" ? "spread" : "choke"] = val(e.chokeMatte);
        item.use_global_light = !!e.useGlobalAngle;
        item.angle = e.useGlobalAngle ? globalAngle : val(e.localLightingAngle);
      } else if (base === "outerGlow" || base === "innerGlow") {
        item.size = val(e.blur);
        item[base === "outerGlow" ? "spread" : "choke"] = val(e.chokeMatte);
        if (e.inputRange != null) item.range = val(e.inputRange);
      }
      out.push(item);
    }
  }
  return { visible: visible, effects: out };
}

// Legacy single stroke field: only when the layer's effects are visible and the stroke is enabled.
function strokeFromEffects(fxInfo) {
  if (!fxInfo.visible) return null;
  for (const e of fxInfo.effects) {
    if (e.type !== "Stroke" || !e.enabled) continue;
    return { enabled: true, position: e.position, size: e.size, color: e.color || null,
             opacity: e.opacity, mode: e.blend_mode || null };
  }
  return null;
}

function isAttrText(kind) {
  return kind === "dynamic_text" || kind === "static_text";
}

// dynamic_text / static_text attributes, text_attrs_version 2 (references/slicing.md). Mirrors
// text_attrs_from_descriptor() in text_render.py. size / size_px are device pixels
// (transform applied); size_pt / leading_pt are Photoshop text-space points.
function parseText(desc) {
  const tk = desc && desc.textKey;
  if (!tk) return null;
  const content = (typeof tk.textKey === "string") ? tk.textKey : (tk.text || "");
  const tf = tk.transform || {};
  const m = { xx: tf.xx != null ? tf.xx : 1, xy: tf.xy || 0, yx: tf.yx || 0, yy: tf.yy != null ? tf.yy : 1 };
  const sx = Math.hypot(m.xx, m.xy) || 1;
  const sy = Math.hypot(m.yx, m.yy) || 1;
  const runs = (tk.textStyleRange || []).map((r) => {
    const st = r.textStyle || {};
    const sizePt = val(st.size);
    const implied = val(st.impliedFontSize);
    const leadPt = val(st.leading);
    const impliedLead = val(st.impliedLeading);
    const autoLead = (st.autoLeading == null) ? true : !!st.autoLeading;
    return {
      from: r.from || 0,
      to: r.to || 0,
      font: st.fontPostScriptName || st.fontName || null,
      size_pt: sizePt,
      size_px: (implied != null) ? implied : (sizePt != null ? sizePt * sy : null),
      color: st.color ? rgbHex(st.color) : "#000000",
      tracking: st.tracking != null ? val(st.tracking) : 0,
      auto_leading: autoLead,
      leading_pt: autoLead ? null : leadPt,
      leading_px: autoLead ? null : ((impliedLead != null) ? impliedLead : (leadPt != null ? leadPt * sy : null)),
      baseline_shift_pt: val(st.baselineShift) || 0,
      faux_bold: !!st.syntheticBold,
      faux_italic: !!st.syntheticItalic,
      horizontal_scale: st.horizontalScale != null ? st.horizontalScale : 100,
      vertical_scale: st.verticalScale != null ? st.verticalScale : 100,
      auto_kern: enumVal(st.autoKern) || "manual"
    };
  });
  const paragraphs = (tk.paragraphStyleRange || []).map((p) => {
    const ps = p.paragraphStyle || {};
    return {
      from: p.from || 0, to: p.to || 0,
      align: enumVal(ps.align) || "left",
      auto_leading_pct: ps.autoLeadingPercentage != null ? val(ps.autoLeadingPercentage) : null,
      leading_type: enumVal(ps.leadingType) || null
    };
  });
  const kerns = Array.from(new Set(runs.map((r) => String(r.auto_kern)))).sort();
  const shapes = tk.textShape || [];
  let shape = "point";
  let boxPt = null;
  if (shapes.length && enumVal(shapes[0].char) === "box") {
    shape = "box";
    const b = shapes[0].bounds;
    if (b) boxPt = { left: val(b.left), top: val(b.top), right: val(b.right), bottom: val(b.bottom) };
  }
  const fxInfo = effectsFromDesc(desc);
  const first = runs[0] || {};
  const click = tk.textClickPoint;
  const warp = tk.warp ? enumVal(tk.warp.warpStyle) : null;
  return {
    text_attrs_version: 2,
    content: content,
    font: first.font || null,
    size: (first.size_px != null) ? first.size_px : null,
    size_pt: (first.size_pt != null) ? first.size_pt : null,
    color: first.color || null,
    alignment: paragraphs.length ? paragraphs[0].align : null,
    leading_type: paragraphs.length ? paragraphs[0].leading_type : null,
    tracking: (first.tracking != null) ? first.tracking : null,
    leading: (first.leading_pt != null) ? first.leading_pt : null,
    leading_px: (first.leading_px != null) ? first.leading_px : null,
    auto_leading: (first.auto_leading != null) ? first.auto_leading : null,
    stroke: strokeFromEffects(fxInfo),
    opacity: (desc.opacity != null) ? (val(desc.opacity) / 255) : null,
    fill_opacity: (desc.fillOpacity != null) ? (val(desc.fillOpacity) / 255) : null,
    click_point: click ? { horizontal: val(click.horizontal), vertical: val(click.vertical) } : null,
    transform: { xx: m.xx, xy: m.xy, yx: m.yx, yy: m.yy, tx: tf.tx || 0, ty: tf.ty || 0 },
    scale: { x: sx, y: sy },
    runs: runs,
    paragraphs: paragraphs,
    kerning: kerns.length === 1 ? kerns[0] : (kerns.length ? "mixed" : "manual"),
    manual_kerning_ranges: (tk.kerningRange || []).length,
    anti_alias: tk.antiAlias ? enumVal(tk.antiAlias) : null,
    warp: (warp && warp !== "warpNone") ? warp : null,
    shape: shape,
    box_bounds_pt: boxPt,
    effects_visible: fxInfo.visible,
    layer_effects: fxInfo.effects
  };
}

function pickBounds(desc, domLayer) {
  const keys = collectBoundKeys(desc);
  const logical = unitRect(desc && desc.boundsNoEffects)
    || (domLayer && domLayer.boundsNoEffects && unitRect(domLayer.boundsNoEffects))
    || null;
  // Prefer an explicit with-effects rect when present.
  const visible = unitRect(desc && (desc.boundsWithEffects || desc.boundsWithFX || desc.boundsExtended))
    || (domLayer && domLayer.bounds && unitRect(domLayer.bounds))
    || unitRect(desc && desc.bounds)
    || null;
  return { keys: keys, logical: logical, visible: visible };
}

function samePath(a, b) {
  const norm = (s) => String(s || "").replace(/\//g, "\\").replace(/^file:\\?/i, "").toLowerCase();
  return norm(a) === norm(b);
}

function snapshotDocs() {
  return app.documents.map((d) => ({
    name: d.name,
    id: d.id,
    path: d.path || "",
    saved: d.saved
  }));
}

function findLayer(container, id) {
  const layers = container.layers || [];
  for (const layer of layers) {
    if (layer.id === id) return layer;
    if (layer.layers && layer.layers.length) {
      const found = findLayer(layer, id);
      if (found) return found;
    }
  }
  return null;
}

function collectAncestorChain(container, id, chain) {
  const layers = container.layers || [];
  for (const layer of layers) {
    if (layer.id === id) return true;
    if (layer.layers && layer.layers.length) {
      if (collectAncestorChain(layer, id, chain)) {
        chain.push(layer);
        return true;
      }
    }
  }
  return false;
}

// Temporarily show a hidden state layer and any hidden ancestors so rasterization
// has pixels. Always restore before the next slice / full render. The source is
// closed without saving when this script opened it.
function revealHiddenChain(src, ids) {
  const restored = [];
  const seen = new Set();
  for (const id of ids) {
    if (id == null) continue;
    const layer = findLayer(src, id);
    const chain = [];
    collectAncestorChain(src, id, chain);
    const all = [];
    if (layer) all.push(layer);
    for (const ancestor of chain) all.push(ancestor);
    for (const lyr of all) {
      if (!lyr || seen.has(lyr.id)) continue;
      seen.add(lyr.id);
      try {
        if (lyr.visible === false) {
          restored.push({ id: lyr.id, name: lyr.name || "", wasVisible: false });
          lyr.visible = true;
        }
      } catch (err) {
        restored.push({ id: lyr.id, name: (lyr && lyr.name) || "", error: String(err) });
      }
    }
  }
  return restored;
}

// Every layer with its own and effective visibility, right after the document is opened (layers_at_open) and
// again before the full render. bounds are document pixels with effects; opacity is 0-100.
function snapshotLayers(doc) {
  const out = [];
  function walk(container, parentId, parentVisible) {
    for (const layer of container.layers || []) {
      let vis = true, kind = null, bounds = null, opacity = null;
      try { vis = layer.visible !== false; } catch (err) {}
      try { kind = String(layer.kind); } catch (err) {}
      try { bounds = unitRect(layer.bounds); } catch (err) {}
      try { opacity = layer.opacity; } catch (err) {}
      const isGroup = !!(layer.layers && layer.layers.length) || String(kind).toLowerCase().indexOf("group") >= 0;
      const eff = parentVisible && vis;
      out.push({ id: layer.id, name: layer.name || "", parent_id: parentId, kind: kind, visible: vis,
                 effective_visible: eff, opacity: opacity, bounds: bounds, group: isGroup });
      if (layer.layers && layer.layers.length) walk(layer, layer.id, eff);
    }
  }
  walk(doc, null, true);
  return out;
}

// Layers the user chose to leave out: a reuse_decisions entry with layer_ids whose decision is an exclusion,
// decided_by "user" AND recorded by `confirm --decision` in the lock's decision_log. Anything else is kept.
const EXCLUDE_TYPES = new Set(["layer_inclusion", "exclude_visible_layer"]);
const TRUTH_TYPES = new Set(["layer_inclusion", "exclude_visible_layer", "hidden_layer_state", "unmasked_asset"]);
const UNMASKED_VALUES = new Set(["unmasked", "export_unmasked", "full", "full_layer", "whole_layer", "unclipped", "yes"]);
const EXCLUDE_VALUES = new Set(["exclude", "excluded", "hide", "hidden", "omit", "not_exported", "no_export",
  "skip", "drop", "old_draft", "leftover", "remove"]);
const PENDING_VALUES = new Set(["", "pending", "wait_for_user", "none", "null"]);

function normDecision(v) { return String(v == null ? "" : v).trim().toLowerCase(); }

function isBlockingDecision(d) {
  if (TRUTH_TYPES.has(d.type) || d.blocking === true) return true;
  const aff = Array.isArray(d.affects) ? d.affects : [d.affects];
  return aff.some((a) => ["truth", "export", "full_render"].indexOf(normDecision(a)) >= 0);
}

function userDecisionState(manifest, decisionLog) {
  const excluded = [];
  const pending = [];
  const unmasked = new Set();
  for (const d of manifest.reuse_decisions || []) {
    if (!d || typeof d !== "object") continue;
    const val = normDecision(d.decision);
    let last = null;
    for (const r of decisionLog || []) if (r && String(r.id) === String(d.id)) last = normDecision(r.decision);
    const answered = d.decision != null && !PENDING_VALUES.has(val) && normDecision(d.decided_by) === "user"
      && last !== null && last === val;
    if (!answered) {
      if (isBlockingDecision(d)) pending.push({ id: d.id, type: d.type || null, layer_ids: d.layer_ids || null });
      continue;
    }
    if (d.type === "unmasked_asset" && UNMASKED_VALUES.has(val)) {
      for (const id of d.layer_ids || []) unmasked.add(Number(id));
      continue;
    }
    if (!(EXCLUDE_TYPES.has(d.type) || isBlockingDecision(d)) || !EXCLUDE_VALUES.has(val)) continue;
    for (const id of d.layer_ids || []) excluded.push({ id: id, decision_id: d.id });
  }
  return { excluded: excluded, pending: pending, unmasked: unmasked };
}

function rectIntersect(a, b) {
  if (!a) return b ? Object.assign({}, b) : null;
  if (!b) return Object.assign({}, a);
  return { left: Math.max(a.left, b.left), top: Math.max(a.top, b.top),
           right: Math.min(a.right, b.right), bottom: Math.min(a.bottom, b.bottom) };
}

function rectUnion(a, b) {
  if (!a) return b ? Object.assign({}, b) : null;
  if (!b) return Object.assign({}, a);
  return { left: Math.min(a.left, b.left), top: Math.min(a.top, b.top),
           right: Math.max(a.right, b.right), bottom: Math.max(a.bottom, b.bottom) };
}

function rectEmpty(r) { return !r || r.right <= r.left || r.bottom <= r.top; }

function maskFlags(desc) {
  return {
    user_mask: !!(desc && desc.hasUserMask) && desc.userMaskEnabled !== false,
    vector_mask: !!(desc && desc.hasVectorMask) && desc.vectorMaskEnabled !== false
  };
}

// The area of the selected layers the document shows: each layer's own bounds clipped by the bounds of every
// ancestor group that has an enabled layer / vector mask (Photoshop's group `bounds` already apply its mask), and by
// its clipping base when the base is not selected too. The layer's own mask travels with "new document from layer",
// so it is only recorded (role self). Returns { clipped, clip_bounds, layer_bounds, sources, mask_layer_ids }.
async function maskClipFor(src, selectIds) {
  const sources = [];
  const maskIds = [];
  let union = null;
  let layerUnion = null;
  let clipped = false;
  for (const id of selectIds) {
    const own = (await bp([{ _obj: "get", _target: [{ _ref: "layer", _id: id }] }]))[0] || {};
    const ownBounds = unitRect(own.bounds);
    layerUnion = rectUnion(layerUnion, ownBounds);
    const ownFlags = maskFlags(own);
    if (ownFlags.user_mask || ownFlags.vector_mask) {
      sources.push({ id: id, name: own.name || "", role: "self", user_mask: ownFlags.user_mask,
                     vector_mask: ownFlags.vector_mask, bounds: ownBounds, bounds_no_mask: unitRect(own.boundsNoMask) });
    }
    let r = ownBounds;
    const chain = [];
    collectAncestorChain(src, id, chain);
    for (const anc of chain) {
      if (!anc || selectIds.indexOf(anc.id) >= 0) continue;
      const ad = (await bp([{ _obj: "get", _target: [{ _ref: "layer", _id: anc.id }] }]))[0] || {};
      const f = maskFlags(ad);
      if (!f.user_mask && !f.vector_mask) continue;
      const ab = unitRect(ad.bounds);
      sources.push({ id: anc.id, name: anc.name || "", role: "ancestor", user_mask: f.user_mask,
                     vector_mask: f.vector_mask, bounds: ab, bounds_no_mask: unitRect(ad.boundsNoMask) });
      if (ab) { r = rectIntersect(r, ab); if (maskIds.indexOf(anc.id) < 0) maskIds.push(anc.id); }
    }
    const dom = findLayer(src, id);
    let isClipped = false;
    try { isClipped = !!(dom && dom.isClippingMask); } catch (errC) {}
    if (isClipped) {
      let sibs = [];
      try { sibs = (dom.parent ? dom.parent.layers : src.layers) || []; } catch (errP) { sibs = []; }
      let k = sibs.findIndex((l) => l.id === id) + 1;
      while (k > 0 && k < sibs.length) {
        let c = false;
        try { c = !!sibs[k].isClippingMask; } catch (errS) {}
        if (!c) break;
        k++;
      }
      const base = (k > 0 && k < sibs.length) ? sibs[k] : null;
      if (base && selectIds.indexOf(base.id) < 0) {
        let bb = null;
        try { bb = unitRect(base.bounds); } catch (errB) {}
        sources.push({ id: base.id, name: base.name || "", role: "clip_base", bounds: bb });
        if (bb) { r = rectIntersect(r, bb); if (maskIds.indexOf(base.id) < 0) maskIds.push(base.id); }
      }
    }
    if (r && ownBounds && (r.left > ownBounds.left || r.top > ownBounds.top || r.right < ownBounds.right
        || r.bottom < ownBounds.bottom)) clipped = true;
    if (!rectEmpty(r)) union = rectUnion(union, r);
  }
  return { clipped: clipped, clip_bounds: clipped ? union : null, layer_bounds: layerUnion,
           sources: sources, mask_layer_ids: maskIds, cropped: false };
}

function restoreHiddenChain(src, restored) {
  if (!restored || !restored.length) return;
  for (let i = restored.length - 1; i >= 0; i--) {
    const rec = restored[i];
    if (rec.wasVisible !== false) continue;
    const lyr = findLayer(src, rec.id);
    if (!lyr) continue;
    try { lyr.visible = false; } catch (err) {}
  }
}

async function flush() {
  const file = await rootDir.createFile(LOG_NAME, { overwrite: true });
  await file.write(JSON.stringify(log, null, 2));
}

async function bp(descriptors) {
  const active = app.activeDocument;
  if (!active || !ours.has(active.id)) {
    throw new Error("GUARD: active document is not ours: " + (active && (active.name + " id=" + active.id)));
  }
  const descs = descriptors.map((d) => {
    const copy = Object.assign({}, d);
    copy._options = Object.assign({}, d._options || {}, { dialogOptions: "silent" });
    return copy;
  });
  const result = await action.batchPlay(descs, {});
  for (const item of result) {
    if (item && item._obj === "error") {
      throw new Error(JSON.stringify(item).slice(0, 400));
    }
  }
  return result;
}

async function ensureEightBit(doc) {
  try {
    if (doc.bitsPerChannel && doc.bitsPerChannel !== "bitDepth8") {
      await bp([{ _obj: "convertMode", depth: 8, merge: false }]);
    }
  } catch (err) {
    log.errs.push({ convertMode: String(err) });
  }
}

async function closeTemp(doc) {
  if (!doc) return;
  try {
    if (ours.has(doc.id)) {
      await doc.closeWithoutSaving();
      ours.delete(doc.id);
    }
  } catch (err) {
    log.errs.push({ close_temp: String(err) });
  }
}

// Avatar/frame split inside the temporary export document (never in the source document):
// Edit Contents opens the embedded smart object of the temporary copy, the listed inner layers
// are hidden, the contents are saved back into that copy only, and the copy is exported as usual.
// Checked on Photoshop 2026 (references/slicing.md): the source document stays unchanged.
function walkLayers(container, out) {
  for (const layer of container.layers || []) {
    out.push(layer);
    if (layer.layers && layer.layers.length) walkLayers(layer, out);
  }
  return out;
}

function matchInnerLayer(all, spec) {
  if (spec == null) return null;
  const id = (typeof spec === "object") ? spec.id : (typeof spec === "number" ? spec : null);
  const name = (typeof spec === "object") ? spec.name : (typeof spec === "string" ? spec : null);
  if (id != null) {
    const byId = all.find((layer) => layer.id === id);
    if (byId && (name == null || byId.name === name)) return byId;
  }
  if (name != null) {
    const byName = all.filter((layer) => layer.name === name);
    if (byName.length === 1) return byName[0];
  }
  return null;
}

async function applySmartObjectSplit(tmp, split, item) {
  const hide = (split && split.hide_inner) || [];
  if (!hide.length) throw new Error("split.hide_inner is empty");
  const smart = walkLayers(tmp, []).filter((layer) => String(layer.kind).toLowerCase().indexOf("smart") >= 0);
  if (smart.length !== 1) {
    throw new Error("split: expected one smart object in the temporary document, found " + smart.length);
  }
  await bp([{ _obj: "select", _target: [{ _ref: "layer", _id: smart[0].id }], makeVisible: false }]);
  const before = new Set(app.documents.map((d) => d.id));
  await bp([{ _obj: "placedLayerEditContents" }]);
  const added = app.documents.filter((d) => !before.has(d.id));
  if (added.length !== 1) throw new Error("split: Edit Contents opened " + added.length + " documents");
  const inner = added[0];
  ours.add(inner.id);
  const record = { contents: inner.name, hidden: [], not_found: [] };
  try {
    app.activeDocument = inner;
    const all = walkLayers(inner, []);
    for (const spec of hide) {
      const layer = matchInnerLayer(all, spec);
      if (!layer) { record.not_found.push(spec); continue; }
      layer.visible = false;
      record.hidden.push({ id: layer.id, name: layer.name });
    }
    if (record.not_found.length) {
      throw new Error("split: inner layers not found: " + JSON.stringify(record.not_found));
    }
    await inner.save();
  } finally {
    await closeTemp(inner);
    app.activeDocument = tmp;
    item.split_applied = record;
  }
}

try {
  await loadConfig();
  log.exporter = await exporterIdentity();
  rootDir = await fs.getEntryWithUrl(ROOT_URL);
  try {
    slicesDir = await rootDir.getEntry(SLICES_DIR_NAME);
  } catch (err) {
    slicesDir = await rootDir.createFolder(SLICES_DIR_NAME);
  }
  log.docs_before = snapshotDocs();
  await flush();

  const manifestFile = await rootDir.getEntry(MANIFEST_NAME);
  const manifestText = await manifestFile.read();
  // 1.4.9 manifest lock: `slicing_helper.py confirm` writes <stem>.confirmed.json (byte copy).
  // A different manifest text means it was edited after the user confirmed it: refuse to export.
  const lockName = MANIFEST_NAME.replace(/\.json$/i, "") + ".confirmed.json";
  let lockedText = null;
  try {
    const lockFile = await rootDir.getEntry(lockName);
    lockedText = await lockFile.read();
  } catch (errLock) {
    lockedText = null;
  }
  log.manifest_locked = lockedText !== null;
  if (lockedText !== null && lockedText !== manifestText) {
    throw new Error("manifest_changed_after_confirm: " + MANIFEST_NAME + " differs from " + lockName +
      "; restore the confirmed manifest, write manifest.proposal.json and ask the user to re-confirm");
  }
  const manifest = JSON.parse(manifestText);
  let decisionLog = [];
  try {
    const shaFile = await rootDir.getEntry(MANIFEST_NAME.replace(/\.json$/i, "") + ".confirmed.sha256");
    decisionLog = (JSON.parse(await shaFile.read()).decision_log) || [];
  } catch (errSha) {
    decisionLog = [];
  }
  const decisionState = userDecisionState(manifest, decisionLog);
  log.pending_user_decisions = decisionState.pending;
  if (manifest.status && manifest.status !== "confirmed" && manifest.status !== "pending_review") {
    // pending_review is allowed only when the operator explicitly treats the auto manifest as confirmed.
    throw new Error("manifest.status must be confirmed (or pending_review for an authorized test run)");
  }
  const artboard = manifest.source && manifest.source.artboard;
  const entries = manifest.entries || [];

  await core.executeAsModal(async (executionContext) => {
    let src = null;
    const excludedRestore = [];
    try {
      executionContext.reportProgress({ value: 0.02, commandName: "open source" });
      // Reuse the copy if it is already open (match by path). Never fall back to another file of the same name.
      for (const doc of app.documents) {
        if (SOURCE_PATH_HINT && doc.path && samePath(doc.path, SOURCE_PATH_HINT)) {
          src = doc;
          break;
        }
      }
      if (!src) {
        const entry = await fs.getEntryWithUrl(SOURCE_URL);
        src = await app.open(entry);
        weOpenedSource = true;
      }
      ours.add(src.id);
      app.activeDocument = src;
      if (weOpenedSource) {
        await executionContext.hostControl.registerAutoCloseDocument(src.id);
      }
      log.src = { name: src.name, id: src.id, path: src.path || "", w: src.width, h: src.height };
      if (SOURCE_PATH_HINT && src.path && !samePath(src.path, SOURCE_PATH_HINT)) {
        throw new Error("GUARD: opened unexpected path: " + src.path);
      }
      // Visibility as the document was opened, before any temporary change (validate: visible_layer_hidden,
      // visible_layer_unassigned).
      const tSnap = nowMs();
      log.layers_at_open = snapshotLayers(src);
      log.layers_at_open_ms = nowMs() - tSnap;
      log.layers_at_open_count = log.layers_at_open.length;
      await flush();
      // 1.4.15: layers hidden at open that an unanswered blocking decision covers are not exported yet.
      const hiddenAtOpen = new Set();
      for (const l of log.layers_at_open) {
        if (l.visible === false || l.effective_visible === false) hiddenAtOpen.add(l.id);
      }
      const pendingByLayer = new Map();
      for (const p of decisionState.pending) {
        for (const id of p.layer_ids || []) {
          const key = Number(id);
          if (!pendingByLayer.has(key)) pendingByLayer.set(key, []);
          pendingByLayer.get(key).push(p.id);
        }
      }

      let suspension;
      try {
        suspension = await executionContext.hostControl.suspendHistory({
          documentID: src.id,
          name: "agent slice export"
        });
      } catch (err) {
        log.errs.push({ suspendHistory: String(err) });
      }

      // User-recorded exclusions only (see userDecisionState); restored before the source is released.
      for (const ex of decisionState.excluded) {
        const lyr = findLayer(src, ex.id);
        const rec = { id: ex.id, decision_id: ex.decision_id, name: lyr ? (lyr.name || "") : null, found: !!lyr };
        try {
          if (lyr && lyr.visible !== false) { lyr.visible = false; excludedRestore.push(lyr.id); rec.hidden = true; }
        } catch (errEx) { rec.error = String(errEx); }
        log.excluded_by_user_decision.push(rec);
      }

      const total = entries.length + 1;
      for (let i = 0; i < entries.length; i++) {
        const entry = entries[i];
        const item = {
          name: entry.name,
          layer_id: entry.layer_id,
          kind: entry.kind,
          ok: false
        };
        const t1 = nowMs();
        let revealed = [];
        try {
          app.activeDocument = src;
          if (!ours.has(src.id)) throw new Error("GUARD: lost source doc");
          const selectIds = (entry.select_ids && entry.select_ids.length)
            ? entry.select_ids
            : [entry.layer_id];
          const blockedIds = selectIds.filter((id) => hiddenAtOpen.has(id) && pendingByLayer.has(Number(id)));
          const skipPending = blockedIds.length > 0 && !isAttrText(entry.kind) && entry.export_png !== false;
          if (skipPending) {
            const decisionIds = [];
            for (const id of blockedIds) {
              for (const did of pendingByLayer.get(Number(id))) if (decisionIds.indexOf(did) < 0) decisionIds.push(did);
            }
            item.skipped_pending_decision = { layer_ids: blockedIds, decision_ids: decisionIds };
            log.skipped_pending_decision.push({ name: entry.name, layer_ids: blockedIds, decision_ids: decisionIds });
          } else if (entry.hidden || entry.from_hidden) {
            revealed = revealHiddenChain(src, selectIds);
            item.revealed = revealed.map((r) => r.id);
          }
          const info = await bp([{ _obj: "get", _target: [{ _ref: "layer", _id: entry.layer_id }] }]);
          const desc = info[0] || {};
          if (!log.bound_keys_sample) {
            log.bound_keys_sample = {
              layer_id: entry.layer_id,
              keys: collectBoundKeys(desc)
            };
          }
          const domLayer = findLayer(src, entry.layer_id);
          const bounds = pickBounds(desc, domLayer);
          item.ps_name = desc.name;
          item.visible_flag = desc.visible;
          item.bound_keys = Object.keys(bounds.keys);
          item.logical_bounds = bounds.logical;
          item.visible_bounds = bounds.visible;
          item.boundsNoEffects = bounds.logical;
          if (selectIds.length > 1) {
            // 1.4.12: the manifest box of a multi-layer entry is the union of its layers; record it.
            item.select_bounds = [];
            let u = null;
            for (const sid of selectIds) {
              try {
                const sd = sid === entry.layer_id ? desc
                  : ((await bp([{ _obj: "get", _target: [{ _ref: "layer", _id: sid }] }]))[0] || {});
                const sb = pickBounds(sd, findLayer(src, sid));
                item.select_bounds.push({ id: sid, logical: sb.logical, visible: sb.visible });
                const r = sb.logical || sb.visible;
                if (r) {
                  u = u ? { left: Math.min(u.left, r.left), top: Math.min(u.top, r.top),
                            right: Math.max(u.right, r.right), bottom: Math.max(u.bottom, r.bottom) } : Object.assign({}, r);
                }
              } catch (errSel) {
                item.select_bounds.push({ id: sid, error: String(errSel) });
              }
            }
            item.logical_bounds_union = u;
          }
          if (isAttrText(entry.kind) || desc.textKey) {
            item.text = parseText(desc) || entry.text || null;
          }
          if (entry.reuse_of) item.reuse_of = entry.reuse_of;
          // Reused instance (export_png === false) or attribute-only text: record
          // bounds / text attrs only; build-layout places shared images, if any.
          if (isAttrText(entry.kind) || entry.export_png === false || skipPending) {
            if (entry.export_png === false) item.bounds_only = true;
            item.ok = true;
            if (revealed && revealed.length) {
              // This path skips the shared restore below, so restore visibility here.
              try { restoreHiddenChain(src, revealed); } catch (errR) { item.restore_error = String(errR); }
            }
            item.ms = nowMs() - t1;
            log.items.push(item);
            await flush();
            continue;
          }

          // 1.4.16: what masks / a clipping base leave visible (before the temporary document is made).
          let maskClip = null;
          try { maskClip = await maskClipFor(src, selectIds); }
          catch (errM) { item.mask_clip_error = String((errM && errM.message) || errM); }
          const unmaskedByUser = !!maskClip && (selectIds.concat(maskClip.mask_layer_ids))
            .some((id) => decisionState.unmasked.has(Number(id)));
          if (maskClip && (maskClip.clipped || maskClip.sources.length)) item.mask_clip = maskClip;
          // Select base + any visible clipped layers, then new document from the target.
          // effect_mode "engine": select_ids are the children of an effect group; the new
          // document has no parent group, so the group's effects are intentionally not baked.
          const selectDescs = selectIds.map((id, idx) => {
            const d = {
              _obj: "select",
