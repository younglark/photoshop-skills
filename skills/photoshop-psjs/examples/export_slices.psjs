          // Root cause of the outline mismatch: layer.bounds on the raster copy
          // is looser than trim (it still includes nearly-transparent padding).
          // After trim, layer.bounds.left/top are the negative insets (e.g. -5,-6).
          // Tight visible origin in source space = before.left - after.left.
          // Do NOT use the pre-trim origin as the PNG's top-left.
          if (item.tmp_aligned_with_source && beforeTrim && afterTrim) {
            const left = cropOrigin.left + beforeTrim.left - afterTrim.left;
            const top = cropOrigin.top + beforeTrim.top - afterTrim.top;
            item.visible_bounds_reported = item.visible_bounds;
            item.visible_bounds = {
              left: left,
              top: top,
              right: left + tmp.width,
              bottom: top + tmp.height
            };
            item.visible_bounds_from_trim_insets = true;
          } else if (item.logical_bounds && item.out_size
              && Math.abs((item.logical_bounds.right - item.logical_bounds.left) - tmp.width) <= 1
              && Math.abs((item.logical_bounds.bottom - item.logical_bounds.top) - tmp.height) <= 1) {
            item.visible_bounds = item.logical_bounds;
            item.visible_bounds_matches_logical = true;
          } else if (item.logical_bounds) {
            const lb = item.logical_bounds;
            item.visible_bounds = {
              left: lb.left,
              top: lb.top,
              right: lb.left + tmp.width,
              bottom: lb.top + tmp.height
            };
            item.visible_bounds_from_logical_plus_png = true;
          }
          const pngName = (entry.image_name || entry.name) + ".png"; // shared image name when reused
          item.image = pngName;
          const png = await slicesDir.createFile(pngName, { overwrite: true });
          await tmp.saveAs.png(png, { compression: 6 }, true);
          item.exported_at = new Date().toISOString();
          await executionContext.hostControl.unregisterAutoCloseDocument(tmp.id);
          await closeTemp(tmp);
          app.activeDocument = src;
          item.ok = true;
        } catch (err) {
          item.ok = false;
          item.error = String((err && err.message) || err);
          try {
            if (app.activeDocument && app.activeDocument !== src && ours.has(app.activeDocument.id)) {
              await closeTemp(app.activeDocument);
            }
          } catch (err2) {}
          try { app.activeDocument = src; } catch (err3) {}
        }
        try {
          if (revealed && revealed.length) {
            app.activeDocument = src;
            restoreHiddenChain(src, revealed);
          }
        } catch (errRestore) {
          item.restore_error = String(errRestore);
          log.errs.push({ restore: entry.name, error: String(errRestore) });
        }
        item.ms = nowMs() - t1;
        log.items.push(item);
        try {
          executionContext.reportProgress({
            value: (i + 1) / total,
            commandName: "slice " + (i + 1) + "/" + entries.length
          });
        } catch (err) {}
        await flush();
      }

      // Full artboard render for validation (1x, 8-bit PNG, clipped to the artboard).
      const fullItem = { name: FULL_RENDER_NAME, ok: false };
      const tFull = nowMs();
      try {
        app.activeDocument = src;
        // Layers visible at open but hidden now (only user-recorded exclusions may be here).
        const openVis = {};
        for (const l of log.layers_at_open || []) openVis[l.id] = l.visible;
        const tSnap2 = nowMs();
        fullItem.hidden_at_render = snapshotLayers(src)
          .filter((l) => openVis[l.id] === true && l.visible === false)
          .map((l) => ({ id: l.id, name: l.name }));
        fullItem.hidden_at_render_ms = nowMs() - tSnap2;
        const hasArtboardId = artboard && artboard.id != null;
        if (hasArtboardId) {
          await bp([{
            _obj: "select",
            _target: [{ _ref: "layer", _id: artboard.id }],
            makeVisible: false
          }]);
          await bp([{
            _obj: "make",
            _target: [{ _ref: "document" }],
            name: "full_render",
            using: { _ref: "layer", _enum: "ordinal", _value: "targetEnum" },
            version: 5
          }]);
        } else {
          await bp([{
            _obj: "duplicate",
            _target: [{ _ref: "document", _id: src.id }],
            name: "full_render"
          }]);
        }
        const tmp = app.activeDocument;
        ours.add(tmp.id);
        try { await executionContext.hostControl.registerAutoCloseDocument(tmp.id); } catch (err) {}
        for (const layer of tmp.layers) {
          if (excludedRestore.indexOf(layer.id) < 0) layer.visible = true; // keep user exclusions hidden
        }
        const wantW = artboard && artboard.size && artboard.size[0];
        const wantH = artboard && artboard.size && artboard.size[1];
        const abBounds = artboard && artboard.bounds; // document coords [l,t,r,b]
        fullItem.before_size = [tmp.width, tmp.height];
        // If the new doc is still the full canvas, crop to the artboard's document box
        // (not 0,0,w,h — that would take the top-left artboard instead).
        if (wantW && wantH && (tmp.width !== wantW || tmp.height !== wantH) && abBounds && abBounds.length === 4) {
          try {
            await bp([{
              _obj: "crop",
              to: {
                _obj: "rectangle",
                left: { _unit: "pixelsUnit", _value: abBounds[0] },
                top: { _unit: "pixelsUnit", _value: abBounds[1] },
                right: { _unit: "pixelsUnit", _value: abBounds[2] },
                bottom: { _unit: "pixelsUnit", _value: abBounds[3] }
              },
              angle: 0,
              delete: true
            }]);
          } catch (err) {
            fullItem.crop_error = String(err);
          }
        } else if (wantW && wantH && (tmp.width !== wantW || tmp.height !== wantH)) {
          try {
            await bp([{
              _obj: "crop",
              to: {
                _obj: "rectangle",
                left: { _unit: "pixelsUnit", _value: 0 },
                top: { _unit: "pixelsUnit", _value: 0 },
                right: { _unit: "pixelsUnit", _value: wantW },
                bottom: { _unit: "pixelsUnit", _value: wantH }
              },
              angle: 0,
              delete: true
            }]);
          } catch (err) {
            fullItem.crop_error = String(err);
          }
        }
        await ensureEightBit(tmp);
        fullItem.out_size = [tmp.width, tmp.height];
        const png = await rootDir.createFile(FULL_RENDER_NAME, { overwrite: true });
        await tmp.saveAs.png(png, { compression: 6 }, true);
        await executionContext.hostControl.unregisterAutoCloseDocument(tmp.id);
        await closeTemp(tmp);
        app.activeDocument = src;
        fullItem.ok = true;
      } catch (err) {
        fullItem.ok = false;
        fullItem.error = String((err && err.message) || err);
        try {
          if (app.activeDocument && app.activeDocument !== src && ours.has(app.activeDocument.id)) {
            await closeTemp(app.activeDocument);
          }
        } catch (err2) {}
        try { app.activeDocument = src; } catch (err3) {}
      }
      fullItem.ms = nowMs() - tFull;
      log.full_render = fullItem;
      for (const id of excludedRestore) {
        try { const lyr = findLayer(src, id); if (lyr) lyr.visible = true; }
        catch (errR) { log.errs.push({ restore_excluded: id, error: String(errR) }); }
      }
      await flush();

      if (suspension && suspension.historySuspensionID != null) {
        try {
          await executionContext.hostControl.resumeHistory(suspension.historySuspensionID);
        } catch (err) {
          log.errs.push({ resumeHistory: String(err) });
        }
      }

      // Close the source only if this script opened it. Never save.
      if (weOpenedSource && src && ours.has(src.id)) {
        try {
          await executionContext.hostControl.unregisterAutoCloseDocument(src.id);
        } catch (err) {}
        await src.closeWithoutSaving();
        ours.delete(src.id);
        src = null;
      }

      const failed = log.items.filter((it) => !it.ok);
      log.ok = failed.length === 0 && !!(log.full_render && log.full_render.ok);
      if (!log.ok && !log.fatal) {
        log.fatal = failed.length
          ? (failed.length + " slice(s) failed")
          : "full render failed";
      }
    } catch (err) {
      log.fatal = String((err && err.stack) || err);
      for (const id of excludedRestore) {
        try { const lyr = src && findLayer(src, id); if (lyr) lyr.visible = true; } catch (errR) {}
      }
      try {
        if (weOpenedSource && src && ours.has(src.id)) {
          await src.closeWithoutSaving();
          ours.delete(src.id);
        }
      } catch (err2) {
        log.errs.push({ close_src: String(err2) });
      }
    }
  }, { commandName: "agent slice export" });
} catch (err) {
  log.fatal = String((err && err.stack) || err);
} finally {
  try { log.docs_after = snapshotDocs(); } catch (err) {
    log.errs.push({ docs_after: String(err) });
  }
  log.done = true;
  log.finished = new Date().toISOString();
  if (!log.ok && !log.fatal) log.fatal = "job ended without ok";
  try { if (rootDir) await flush(); } catch (err) {}
}
